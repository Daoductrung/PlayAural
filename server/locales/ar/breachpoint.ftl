breachpoint-reload-shells-you = تُلقّم { $loaded } خرطوشة في { $weapon }. { $ammunition }.
breachpoint-reload-player = يعيد { $player } تلقيم { $weapon }.
breachpoint-hold-angle-you = تثبّت زاوية بـ { $weapon } نحو { $location }. ينتهي تفعيلك.
breachpoint-hold-angle-player = يثبّت { $player } زاوية بـ { $weapon } نحو { $location }.
breachpoint-round-income = دخل الجولة: ${ $amount }. الرصيد: ${ $cash }.
breachpoint-kill-reward = مكافأة الإقصاء: ${ $amount }. الرصيد: ${ $cash }.
breachpoint-phase-preplant = جولة تكتيكية { $round } من { $limit }
breachpoint-phase-postplant-armed = القنبلة مزروعة؛ تتبقى { $total } جولات تكتيكية كاملة
breachpoint-phase-postplant = القنبلة مزروعة { $round } من { $total }
