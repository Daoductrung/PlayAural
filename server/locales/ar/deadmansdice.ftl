deadmansdice-select-bid-quantity = اختر كمية الرهان
deadmansdice-select-bid-quantity-for-face = تراهن على { $face }. اختر كمية.
deadmansdice-bid-option = { $quantity } { $face }
deadmansdice-read-dice = اقرأ نردك
deadmansdice-read-dice-description = استمع إلى نردك الخمسة المخفية مرة أخرى.
deadmansdice-read-table = قراءة الطاولة
deadmansdice-read-table-description = راجع الجولة والقواعد والرهان الحالي والدور وسُمّ كل لاعب.
deadmansdice-review-bids = مراجعة الرهانات
deadmansdice-review-bids-description = راجع رهانات هذه الجولة بالترتيب.
deadmansdice-review-last-reveal = مراجعة الكشف الأخير
deadmansdice-review-last-reveal-description = راجع كل نردة مكشوفة ونتيجة التحدي السابق.

deadmansdice-face-1 = من فئة الواحد
