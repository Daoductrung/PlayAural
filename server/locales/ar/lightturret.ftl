game-name-lightturret = برج خفيف
lightturret-intro = البرج الخفيف يبدأ بـ { $power } سعة الطاقة و { $rounds } جولات كاملة. النار للحصول على الضوء ومضاعفة عدد العملات المعدنية. البرج الزائد فقط عندما يتجاوز الضوء الطاقة. تكلفة الترقيات الأساسية { $cost } العملات المعدنية وقد تأتي بنتائج عكسية.
lightturret-intro-brief = برج خفيف: { $power } القوة، { $rounds } جولات، ترقيات { $cost } عملات معدنية.
lightturret-round-start =
    جولة { $round } من { $total } يبدأ بـ { $alive } نشط { $alive ->
        [one] برج
       *[other] الأبراج
    }.
lightturret-round-start-brief = جولة { $round }/{ $total }. نشط: { $alive }.
lightturret-shoot = برج النار
lightturret-shoot-safe-label = برج النار { $headroom } القدرة الآمنة
lightturret-shoot-risk-label = برج النار { $risk }% خطر التحميل الزائد
lightturret-upgrade = ترقية الأساسية
lightturret-upgrade-label = ترقية الأساسية. التكاليف { $cost } عملات معدنية، لديك { $coins }
lightturret-check-stats = عرض حالة البرج
lightturret-you-shoot = أنت تطلق وتكسب { $gain } لايت بلس { $coins } عملات معدنية. برجك في { $light } من { $power } القوة مع { $headroom } القدرة الآمنة و { $total_coins } عملات معدنية.
lightturret-player-shoots = { $player } نيران ومكاسب { $gain } لايت بلس { $coins } عملات معدنية. برجهم في { $light } ل { $power } القوة مع { $headroom } القدرة الآمنة و { $total_coins } عملات معدنية.
lightturret-you-shoot-brief = أنت تطلق: +{ $gain } ضوء +{ $coins } عملات معدنية. نور { $light }/{ $power }; عملات معدنية { $total_coins }.
lightturret-player-shoots-brief = { $player } حرائق: +{ $gain } ضوء +{ $coins } عملات معدنية. نور { $light }/{ $power }; عملات معدنية { $total_coins }.
lightturret-you-shoot-overload = أنت تطلق وتكسب { $gain } لايت بلس { $coins } عملات معدنية تصل إلى { $light } ضوء ضد { $power } قوة. لقد تجاوزت السعة بمقدار { $overload } ويتم التخلص منها بـ { $total_coins } العملات المتبقية.
lightturret-player-shoots-overload = { $player } نيران ومكاسب { $gain } لايت بلس { $coins } عملات معدنية تصل إلى { $light } ضوء ضد { $power } قوة. إنهم يتجاوزون السعة بمقدار { $overload } ويتم التخلص منها بـ { $total_coins } العملات المتبقية.
lightturret-you-shoot-overload-brief = أنت تفرط في: +{ $gain } ضوء، { $light }/{ $power }، انتهى بواسطة { $overload }. مستبعد.
lightturret-player-shoots-overload-brief = { $player } الأحمال الزائدة: +{ $gain } ضوء، { $light }/{ $power }، انتهى بواسطة { $overload }. مستبعد.
lightturret-you-upgrade = تنفق { $cost } العملات المعدنية وترقية النواة بواسطة { $gain } قوة. برجك الآن في { $light } ضوء، { $power } القوة، { $headroom } القدرة الآمنة و { $coins } عملات معدنية.
lightturret-player-upgrades = { $player } ينفق { $cost } العملات المعدنية وترقية النواة بواسطة { $gain } قوة. برجهم الآن في { $light } ضوء، { $power } القوة، { $headroom } القدرة الآمنة و { $coins } عملات معدنية.
lightturret-you-upgrade-brief = قمت بالترقية: +{ $gain } قوة. نور { $light }/{ $power }; عملات معدنية { $coins }.
lightturret-player-upgrades-brief = { $player } الترقيات: +{ $gain } قوة. ضوء { $light }/{ $power }; عملات معدنية { $coins }.
lightturret-you-upgrade-accident = تنفق { $cost } عملات معدنية، لكن النواة تأتي بنتائج عكسية وتضيف { $gain } ضوء. برجك في { $light } من { $power } القوة مع { $headroom } القدرة الآمنة و { $coins } عملات معدنية.
lightturret-player-upgrades-accident = { $player } ينفق { $cost } عملات معدنية، لكن النواة تأتي بنتائج عكسية وتضيف { $gain } ضوء. برجهم في { $light } من { $power } القوة مع { $headroom } القدرة الآمنة و { $coins } عملات معدنية.
lightturret-you-upgrade-accident-brief = الترقية الخاصة بك تأتي بنتائج عكسية: +{ $gain } ضوء. نور { $light }/{ $power }; عملات معدنية { $coins }.
lightturret-player-upgrades-accident-brief = { $player }ترقية 's تأتي بنتائج عكسية: +{ $gain } ضوء. نور { $light }/{ $power }; عملات معدنية { $coins }.
lightturret-you-upgrade-overload = تنفق { $cost } عملات معدنية، لكن النواة تأتي بنتائج عكسية وتضيف { $gain } ضوء. تصل { $light } ضوء ضد { $power } الطاقة، تتجاوز السعة بمقدار { $overload }، ويتم التخلص منها بـ { $coins } العملات المتبقية.
lightturret-player-upgrades-overload = { $player } ينفق { $cost } عملات معدنية، لكن النواة تأتي بنتائج عكسية وتضيف { $gain } ضوء. يصلون إلى { $light } ضوء ضد { $power } الطاقة، تتجاوز السعة بمقدار { $overload }، ويتم القضاء عليها { $coins } العملات المتبقية.
lightturret-you-upgrade-overload-brief = ترقية التحميل الزائد: +{ $gain } ضوء، { $light }/{ $power }، انتهى بواسطة { $overload }. مستبعد.
lightturret-player-upgrades-overload-brief = { $player } التحميل الزائد للترقية: +{ $gain } ضوء، { $light }/{ $power }، انتهى بواسطة { $overload }. مستبعد.
lightturret-action-resolving = لقد تم بالفعل حل عمل البرج الخاص بك. انتظر حتى ينتهي الصوت والنتيجة.
lightturret-not-enough-coins = تحتاج { $need } عملات معدنية لترقية النواة، ولكن لديك { $have }.
lightturret-you-are-eliminated = لقد تم تحميل برجك بشكل زائد وتم القضاء عليك، لذا لا يمكنك اتخاذ إجراء آخر.
lightturret-confirm-risky-shot = إطلاق النار الآن لديه { $risk }% خطر التحميل الزائد عند { $light } ضوء و { $power } قوة. النار مرة أخرى في الداخل { $seconds } ثواني للتأكيد.
lightturret-status-round = جولة { $round } من { $total }. الأبراج النشطة: { $alive }.
lightturret-stats-alive = { $player }: { $light } ضوء، { $power } القوة، { $headroom } القدرة الآمنة، { $coins } العملات المعدنية، خطر التحميل الزائد في اللقطة التالية { $risk }%.
lightturret-stats-eliminated = { $player }: تم القضاء عليه في { $light } ضوء ضد { $power } قوة.
lightturret-end-max-rounds = الكل { $total } جولات كاملة. مجاميع الضوء النهائية تحدد الفائز.
lightturret-end-max-rounds-brief = { $total } جولات كاملة.
lightturret-end-all-eliminated = تم تحميل كل برج بشكل زائد أثناء الجولة { $round }. مجاميع الضوء النهائية تحدد الفائز.
lightturret-end-all-eliminated-brief = جميع الأبراج محملة بشكل زائد في الجولة { $round }.
lightturret-you-win =
    تربح مع { $light } ضوء و { $power } قوة. { $survived ->
        [true] نجا برجك.
       *[false] إجمالي الضوء النهائي الخاص بك يؤدي على الرغم من الحمل الزائد.
    }
lightturret-player-wins =
    { $player } يفوز مع { $light } ضوء و { $power } قوة. { $survived ->
        [true] نجا برجهم.
       *[false] إجمالي الضوء النهائي يتقدم على الرغم من الحمل الزائد.
    }
lightturret-you-win-brief = لقد فزت: { $light } ضوء.
lightturret-player-wins-brief = { $player } الانتصارات: { $light } ضوء.
lightturret-you-tie = أنت تتعادل لأول مرة مع { $players } في { $light } ضوء.
lightturret-players-tie = { $players } التعادل لأول مرة في { $light } ضوء.
lightturret-you-tie-brief = أنت تربط مع { $players }: { $light } ضوء.
lightturret-players-tie-brief = التعادل: { $players }, { $light } ضوء.
lightturret-set-starting-power = قوة البداية: { $power }
lightturret-enter-starting-power = أدخل قوة البداية:
lightturret-option-changed-power = تم ضبط طاقة البدء على { $power }.
lightturret-desc-starting-power = سعة التحميل الزائد الأولية لكل برج. الضوء الذي يساوي القوة آمن؛ الضوء فقط فوق أحمال الطاقة الزائدة (الافتراضي 10، النطاق 5-30).
lightturret-set-max-rounds = الحد الأقصى للجولات: { $rounds }
lightturret-enter-max-rounds = أدخل الحد الأقصى للجولات:
lightturret-option-changed-rounds = تم ضبط الحد الأقصى للجولات على { $rounds }.
lightturret-desc-max-rounds = عدد الجولات الكاملة. يتلقى كل برج نشط دورة واحدة في الجولة النهائية (الافتراضي 50، النطاق 10-200).
lightturret-error-starting-power-invalid = يجب أن تكون قوة البداية بين { $min } و { $max }; القيمة الحالية هي { $power }.
lightturret-error-max-rounds-invalid = يجب أن يكون الحد الأقصى للجولات بين { $min } و { $max }; القيمة الحالية هي { $rounds }.
lightturret-status-survived = نشط
lightturret-status-eliminated = تم الحذف
lightturret-end-winner = الفائز: { $player } مع { $light } ضوء.
lightturret-end-tie = تعادل المركز الأول: { $players } مع { $light } ضوء.
lightturret-line-format = { $rank }. { $player }: { $light } ضوء، { $power } القوة، { $coins } عملات معدنية، { $status }
