# Nine game messages

# Game name and description
game-name-nine = تسعة
nine-description = لعبة ورق روسية شعبية يقوم فيها اللاعبون ببناء تسلسلات البدلة.
# Player count validation
nine-error-invalid-player-count = تسعة تستخدم مجموعة مكونة من 36 بطاقة وتتسع لـ 3 أو 4 أو 6 لاعبين بالضبط.
nine-error-starting-nine-missing = ولم يتم العثور على الماسات التسعة في أي يد. لا يمكن أن تستمر اللعبة.
# Dealing messages
nine-player-nine-deal = التعامل { $cards } بطاقات لكل لاعب.
# Game start
nine-you-start-player-announcement = لديك تسعة الماسات وابدأ اللعبة.
nine-player-start-player-announcement = { $player } لديه تسعة من الماس ويبدأ اللعبة.
nine-you-start-player-announcement-brief = عليك أن تبدأ مع تسعة من الماس.
nine-player-start-player-announcement-brief = { $player } يبدأ بتسعة الماسات.
# Turn actions
nine-you-plays-starting-nine = أنت تلعب { $card } لفتح الطاولة.
nine-player-plays-starting-nine = { $player } يلعب { $card } لفتح الطاولة.
nine-you-plays-starting-nine-brief = أنت تلعب { $card }.
nine-player-plays-starting-nine-brief = { $player }: { $card }.
nine-you-plays-nine-suit = أنت تلعب { $card } لبدء { $suit } تسلسل.
nine-player-plays-nine-suit = { $player } يلعب { $card } لبدء { $suit } تسلسل.
nine-you-plays-nine-suit-brief = تبدأ { $suit } مع { $card }.
nine-player-plays-nine-suit-brief = { $player } يبدأ { $suit } مع { $card }.
nine-you-extend-sequence = قمت بتمديد { $suit } التسلسل مع { $card }.
nine-player-extend-sequence = { $player } يمتد { $suit } التسلسل مع { $card }.
nine-you-extend-sequence-brief = أنت تلعب { $card } على { $suit }.
nine-player-extend-sequence-brief = { $player }: { $card } على { $suit }.
nine-you-skips-turn = ليس لديك بطاقة قانونية للعب، لذلك تم تخطي دورك.
nine-player-skips-turn = { $player } ليس لديه بطاقة قانونية للعب ويتخطى دوره.
nine-you-skips-turn-brief = أنت تتخطى؛ لا توجد بطاقة قانونية.
nine-player-skips-turn-brief = { $player } يتخطى؛ لا توجد بطاقة قانونية.
# Reasons for not being able to play a card
nine-reason-not-your-turn = إنه ليس دورك.
nine-reason-card-slot-gone = تلك البطاقة لم تعد في يدك. تم تحديث قائمة يدك.
nine-reason-must-play-starting-nine = يجب أن تكون المسرحية الأولى { $starting_card }. { $card } لا يمكن اللعب حتى يتم فتح الطاولة.
nine-reason-nine-already-started = { $card } لا يمكن تشغيلها لأن { $suit } التسلسل مفتوح بالفعل.
nine-reason-cannot-extend = { $card } لا يمكن تمديد { $suit } تسلسل. قم بتشغيل البطاقة التالية السفلية أو الأعلى التالية في أحد نهايات هذا التسلسل.
nine-reason-unopened-suit = { $card } لا يمكن تشغيلها لأن { $suit } لم يتم فتح التسلسل بعد. ابدأ تلك البدلة بالرقم 9 أولاً.
nine-reason-must-skip = ليس لديك بطاقة قانونية لتلعب بها؛ سيتم تخطي دورك تلقائيا.
nine-reason-generic = لا يمكن لعب هذه البطاقة الآن.
# Winning
nine-you-wins-game = ليس لديك أي بطاقات متبقية واربح اللعبة!
nine-player-wins-game = { $player } ليس لديه أي بطاقات متبقية ويفوز باللعبة!
nine-you-wins-game-brief = فزت!
nine-player-wins-game-brief = { $player } يفوز!
nine-player-game-ended = انتهت لعبة التسعة.
nine-you-game-ended = انتهت لعبة التسعة.
nine-you-win = فزت!
nine-you-lose = تخسر!
nine-final-score = البطاقات المتبقية: { $score }
# Status
nine-status = { $name }: { $cards_left } بطاقات اليسار.
nine-status-sequence = { $suit } التسلسل: { $sequence }.
nine-status-no-sequence = لا { $suit } بدأ التسلسل بعد.
nine-sequence-range = { $low } من خلال { $high }
nine-none = لا شيء
nine-action-check-sequences = التحقق من التسلسل
nine-action-check-hand-counts = التحقق من أعداد اليد
nine-status-player-hand-count = { $player }: { $count } بطاقات
