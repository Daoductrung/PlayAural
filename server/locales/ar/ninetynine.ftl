game-name-ninetynine = تسعة وتسعون
ninetynine-description = لعبة ورق حيث يحاول اللاعبون تجنب دفع إجمالي عدد النقاط إلى ما يزيد عن 99. آخر لاعب يقف هو الفائز!
ninetynine-round = جولة { $round }.
ninetynine-player-turn = { $player }دور.
ninetynine-you-play = أنت تلعب { $card }. العد الآن { $count }.
ninetynine-player-plays = { $player } مسرحيات { $card }. العد الآن { $count }.
ninetynine-direction-reverses = اتجاه اللعب ينعكس!
ninetynine-you-skipped = لقد تم تخطيك.
ninetynine-player-skipped = { $player } تم تخطيه.
n99-card-plus-10 = +10
n99-card-minus-10 = -10
n99-card-pass = تمرير
n99-card-reverse = عكس
n99-card-skip = تخطي
n99-card-ninety-nine = تسعة وتسعون
ninetynine-you-lose-tokens =
    تخسر { $amount } { $amount ->
        [one] رمز
       *[other] الرموز
    }.
ninetynine-player-loses-tokens =
    { $player } يخسر { $amount } { $amount ->
        [one] رمز
       *[other] الرموز
    }.
ninetynine-you-eliminated = لقد تم القضاء عليك!
ninetynine-player-eliminated = { $player } تم القضاء عليه!
ninetynine-you-win = لقد فزت باللعبة!
ninetynine-player-wins = { $player } يفوز باللعبة!
ninetynine-end-score =
    { $rank }. { $player }: { $tokens } { $tokens ->
        [one] رمز
       *[other] الرموز
    }
ninetynine-you-deal = أنت توزع البطاقات.
ninetynine-player-deals = { $player } يتعامل مع البطاقات.
ninetynine-you-draw = أنت ترسم { $card }.
ninetynine-player-draws = { $player } يرسم بطاقة.
ninetynine-you-no-valid-cards = ليس لديك بطاقات لن تتجاوز 99!
ninetynine-player-no-valid-cards = { $player } ليس لديه بطاقات لن تتجاوز 99!
ninetynine-no-valid-cards = { $player } ليس لديه بطاقات لن تتجاوز 99!
ninetynine-current-count = العدد هو { $count }.
ninetynine-next-round-wait = الجولة القادمة ستبدأ في { $seconds } ثواني.
ninetynine-ace-choice = هل تلعب Ace كـ +1 أو +11؟
ninetynine-ace-add-eleven = أضف 11
