scopa-option-changed-instant = فوز فوري على سكوبا { $enabled }.
scopa-desc-instant-win-scopas = عند التمكين، يفوز Scopa الصالح باللعبة على الفور. لا يمكن دمج هذا مع No Scopas أو Inverse Scopa.
scopa-option-changed-team-scoring = تسجيل بطاقة الفريق { $enabled }.
scopa-desc-team-card-scoring = يتحكم في ما إذا كان زملاء الفريق يجمعون البطاقات الملتقطة لتسجيل الأهداف في نهاية الجولة. إذا تم تعطيلها في لعبة جماعية، فسيتم تقييم عمليات التقاط كل لاعب بشكل منفصل وتضاف أي نقاط تم ربحها إلى فريق ذلك اللاعب.
scopa-option-changed-inverse = الوضع العكسي { $enabled }.
scopa-desc-inverse-scopa = يعكس الهدف بحيث يؤدي الوصول إلى النتيجة المستهدفة إلى القضاء على اللاعب أو الفريق.
scopa-option-changed-manual = اختيار الالتقاط اليدوي { $enabled }.
scopa-desc-manual-selection = يتيح للاعبين اختيار مجموعة الالتقاط يدويًا عند وجود أكثر من عملية التقاط قانونية واحدة.
scopa-option-changed-asso = أسو بيجليا توتو { $enabled }.
scopa-desc-asso-piglia-tutto = تمكين الآس من أخذ كل شيء: الآس يكتسح الطاولة ويسجل سكوبا ما لم يكن هناك آس آخر موجود بالفعل. لا يمكن دمج هذا مع اسكوبا.
scopa-option-changed-primiera = التهديف التقليدي للدوري الممتاز { $enabled }.
scopa-desc-primiera-scoring = تمكن من تسجيل الأهداف التقليدية في الدوري الممتاز؛ عند إيقاف التشغيل، تستخدم اللعبة متغير Most Sevens الأبسط.
scopa-option-changed-napola = نابولا { $enabled }.
scopa-desc-napola = تمنح نقاطًا إضافية مقابل التقاط تسلسل ماسي متواصل بدءًا من الآس.
scopa-mechanic-normal = عادي
scopa-mechanic-no_scopas = لا سكوبا
scopa-mechanic-only_scopas = سكوبا فقط
scopa-timer-not-active = الموقت الدائري غير نشط.
scopa-error-not-enough-cards =
    لا توجد بطاقات كافية في { $decks } { $decks ->
        [one] السطح
       *[other] الطوابق
    } ل { $players } { $players ->
        [one] لاعب
       *[other] اللاعبين
    } مع { $cards_per_deal } بطاقات لكل منهما. (تحتاج إلى { $cards_per_deal } × { $players } = { $cards_needed } بطاقات، ولكن تحتوي فقط على { $total_cards }.)
scopa-line-format = { $rank }. { $player }: { $points }
