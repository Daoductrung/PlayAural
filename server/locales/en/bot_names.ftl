## Locale-owned generated bot names. The first 26 names are sourced from the
## local PlayPalace server's canonical pool. Keep every base name between 3
## and 30 letters, numbers, or spaces. The pipe is reserved as the list
## separator; another locale's pool may be shorter and need not translate
## these entries.

bot-name-pool =
    .names = Alice | Bob | Charlie | Diana | Eve | Frank | Grace | Henry | Ivy | Jack | Kate | Leo | Mia | Noah | Olivia | Pete | Quinn | Rose | Sam | Tina | Uma | Vic | Wendy | Xander | Yara | Zack | Stupid bot | Wrong Button | Lucky Guess | Still Thinking | Tiny Brain | Lost Again | Sleepy Bot | No Clue | Oops | Maybe Later

bot-display-name = { $name } (Bot)
bot-display-name-numbered = { $name } { $number } (Bot)
