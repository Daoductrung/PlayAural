game-name-deadmansdice = Dead Man's Dice

deadmansdice-set-rules = Rules: { $rules }
deadmansdice-select-rules = Choose the rules
deadmansdice-option-changed-rules = Rules changed to { $rules }.
deadmansdice-rules-traditional = Traditional
deadmansdice-rules-basic = Basic
deadmansdice-rules-unsupported = Unsupported
deadmansdice-rules-description = Traditional rules make ones wild when counting twos through sixes. Basic rules count every face literally. Both rulesets allow Spot On.

deadmansdice-call-liar = Call liar
deadmansdice-call-liar-description = Challenge the current bid. If it is too high, the bidder drinks poison; otherwise you do.
deadmansdice-call-liar-current = Call liar — { $quantity } { $face }
deadmansdice-call-liar-current-description = Challenge the bid of { $quantity } { $face }. If it is too high, the bidder drinks poison; otherwise you do.
deadmansdice-call-spot-on = Call Spot On
deadmansdice-call-spot-on-description = Claim that the current bid is exact. If you are right, every other survivor drinks poison; if not, you do.
deadmansdice-call-spot-on-current = Call Spot On — exactly { $quantity } { $face }
deadmansdice-call-spot-on-current-description = Claim there are exactly { $quantity } { $face }. If you are right, every other survivor drinks poison; if not, you do.
deadmansdice-bid-face = Bid { $face }
deadmansdice-bid-face-minimum = Bid { $face } — { $minimum } or more
deadmansdice-bid-face-description = Choose a quantity, then bid that many { $face } across the table.
deadmansdice-select-bid-quantity = Choose the bid quantity
deadmansdice-select-bid-quantity-for-face = Bidding { $face }. Choose a quantity.
deadmansdice-bid-option = { $quantity } { $face }
deadmansdice-read-dice = Read your dice
deadmansdice-read-dice-description = Hear your five hidden dice again.
deadmansdice-read-table = Read table
deadmansdice-read-table-description = Review the round, rules, current bid, turn, and every player's poison.
deadmansdice-review-bids = Review bids
deadmansdice-review-bids-description = Review this round's bids in order.
deadmansdice-review-last-reveal = Review last reveal
deadmansdice-review-last-reveal-description = Review every revealed die and the outcome of the previous challenge.

deadmansdice-face-1 = ones
deadmansdice-face-2 = twos
deadmansdice-face-3 = threes
deadmansdice-face-4 = fours
deadmansdice-face-5 = fives
deadmansdice-face-6 = sixes
deadmansdice-face-1-singular = one
deadmansdice-face-2-singular = two
deadmansdice-face-3-singular = three
deadmansdice-face-4-singular = four
deadmansdice-face-5-singular = five
deadmansdice-face-6-singular = six

deadmansdice-intro = The tavern closes in. Cups settle. Only one of you will leave standing.
deadmansdice-match-setup-traditional = { $players } players. Rules: { $rules }. Ones are wild for twos through sixes; a bid on ones counts only actual ones.
deadmansdice-match-setup-basic = { $players } players. Rules: { $rules }. Every face counts only itself, including ones.
deadmansdice-match-setup-unsupported = The table cannot begin because its rules are no longer supported.
deadmansdice-round-start = Round { $round }. { $players } survivors seal { $dice } dice beneath their cups.
deadmansdice-your-dice = Your dice: { $dice }.
deadmansdice-you-bid = You bid { $quantity } { $face }.
deadmansdice-player-bids = { $player } bids { $quantity } { $face }.
deadmansdice-you-call-liar = You call { $bidder } a liar over { $quantity } { $face }.
deadmansdice-player-calls-liar = { $player } calls { $bidder } a liar over { $quantity } { $face }.
deadmansdice-you-call-spot-on = You call Spot On against { $bidder }'s bid of { $quantity } { $face }.
deadmansdice-player-calls-spot-on = { $player } calls Spot On against { $bidder }'s bid of { $quantity } { $face }.
deadmansdice-your-cup-reveals = Your cup lifts: { $dice }.
deadmansdice-player-cup-reveals = { $player }'s cup lifts: { $dice }.
deadmansdice-reveal-total = The cups hold { $actual }. The bid was { $quantity } { $face }.
deadmansdice-your-bid-too-high = Your bid collapses under the reveal. You lose the challenge.
deadmansdice-player-bid-too-high = { $player }'s bid collapses under the reveal. { $player } loses the challenge.
deadmansdice-you-challenged-truth = The bid survives the reveal. You lose the challenge.
deadmansdice-player-challenged-truth = The bid survives the reveal. { $player } loses the challenge.
deadmansdice-your-spot-on-correct = Your Spot On is exact. Everyone else must drink.
deadmansdice-player-spot-on-correct = { $player } calls it exactly. Everyone else must drink.
deadmansdice-your-spot-on-wrong = Your Spot On misses. The poison is yours.
deadmansdice-player-spot-on-wrong = { $player } misses the exact count and must drink.
deadmansdice-you-drink-poison = You swallow the poison. Dose { $doses } of { $maximum }.
deadmansdice-player-drinks-poison = { $player } swallows the poison. Dose { $doses } of { $maximum }.
deadmansdice-you-eliminated = The second dose takes you. You are out.
deadmansdice-player-eliminated = The second dose takes { $player }. { $player } is out.
deadmansdice-you-win = You are the last survivor. You win Dead Man's Dice.
deadmansdice-player-wins = { $player } is the last survivor and wins Dead Man's Dice.

deadmansdice-action-opening = The table is still settling. Wait for the first roll.
deadmansdice-action-opening-no-dice = Your cup is still empty. The opening roll has not begun.
deadmansdice-action-opening-no-bids = No one has rolled yet, so there are no bids to review.
deadmansdice-action-eliminated = You have been eliminated from this match.
deadmansdice-action-no-bid = No bid has been made, so there is nothing to challenge.
deadmansdice-action-face-unavailable = No legal raise remains for that face.
deadmansdice-action-invalid-bid = That bid is no longer legal; the table has moved on.
deadmansdice-action-selection-open = Finish or cancel the open bid selector first.
deadmansdice-action-sequence-running = The challenge is still unfolding. Wait for the final outcome.
deadmansdice-action-no-dice = You do not have an active roll to read.
deadmansdice-action-no-last-reveal = No challenge has been revealed yet.

deadmansdice-table-opening-header = Dead Man's Dice — the table is settling, { $rules } rules
deadmansdice-table-header = Dead Man's Dice — round { $round }, { $rules } rules
deadmansdice-table-pool-opening = { $players } players wait with { $dice } dice still unrolled.
deadmansdice-table-pool =
    { $players ->
        [one] 1 survivor
       *[other] { $players } survivors
    }; { $dice } dice in play.
deadmansdice-table-rule-traditional = Ones are wild for bids on twos through sixes. A bid on ones counts only actual ones. Spot On is available.
deadmansdice-table-rule-basic = Every face counts only itself, including ones. Spot On is available.
deadmansdice-table-rule-unsupported = The selected rules are unsupported; this match cannot continue safely.
deadmansdice-table-current-bid-you = Current bid: your { $quantity } { $face }.
deadmansdice-table-current-bid = Current bid: { $quantity } { $face }, by { $player }.
deadmansdice-table-no-bid = No bid has been made this round.
deadmansdice-table-turn-you = It is your turn.
deadmansdice-table-turn = It is { $player }'s turn.
deadmansdice-table-no-turn = No turn is active yet.
deadmansdice-table-player-you = You: poison dose { $doses } of { $maximum }.
deadmansdice-table-player = { $player }: poison dose { $doses } of { $maximum }.
deadmansdice-table-player-you-eliminated = You: eliminated.
deadmansdice-table-player-eliminated = { $player }: eliminated.
deadmansdice-bids-header = Round { $round } bids
deadmansdice-bids-none = No bids have been made this round.
deadmansdice-bids-line-you = { $index }. You: { $quantity } { $face }.
deadmansdice-bids-line = { $index }. { $player }: { $quantity } { $face }.
deadmansdice-last-reveal-header = Last reveal — round { $round }
deadmansdice-last-reveal-player-you = You: { $dice }.
deadmansdice-last-reveal-player = { $player }: { $dice }.
deadmansdice-last-reveal-pending = The cups are still lifting, one at a time.
deadmansdice-last-reveal-result = Bid: { $quantity } { $face }. Actual: { $actual }. { $result }
deadmansdice-last-result-liar-bidder-lost-you = Your bid was too high; you lost the challenge.
deadmansdice-last-result-liar-challenger-lost-you = The bid held; you lost the challenge.
deadmansdice-last-result-spot-correct-you = Your Spot On was exact; everyone else drank.
deadmansdice-last-result-spot-wrong-you = Your Spot On missed; you drank.
deadmansdice-last-result-liar-bidder-lost = The bid was too high; { $player } lost the challenge.
deadmansdice-last-result-liar-challenger-lost = The bid held; { $player } lost the challenge.
deadmansdice-last-result-spot-correct = Spot On was exact; everyone except { $player } drank.
deadmansdice-last-result-spot-wrong = Spot On missed; { $player } drank.
deadmansdice-last-result-unavailable = The previous challenge result is unavailable.

deadmansdice-results-header = Dead Man's Dice results
deadmansdice-results-winner = Last survivor: { $player }.
deadmansdice-results-line = { $player }: { $status }; { $bids } bids, { $challenges } liar calls, { $spots } Spot On calls, { $poison } poison doses.
deadmansdice-results-survived = survived
deadmansdice-results-eliminated = eliminated
deadmansdice-error-rules-invalid = The selected rules are not supported.
