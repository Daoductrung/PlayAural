game-name-eightball = Pool
eightball-option-mode = Mode: { $mode }
eightball-option-mode-prompt = Choose the pool mode
eightball-option-mode-changed = Pool mode set to { $mode }.
eightball-option-mode-description = Eight-Ball Singles is one against one under WPA rules. Eight-Ball Doubles is two against two under WPA rules with partners alternating shots. Five-player Cutthroat follows the published BCA rules: each player protects three balls and pockets opponents' balls.
eightball-mode-eightball_singles = Eight-Ball Singles, 2 players
eightball-mode-eightball_doubles = Eight-Ball Doubles, 4 players
eightball-mode-cutthroat_five = Cutthroat, 5 players
eightball-option-language = Table language: { $language }
eightball-option-language-prompt = Choose the table language
eightball-option-language-changed = Table language set to { $language }.
eightball-option-language-description = Sets every spoken game message at this table to English, Spanish, or Portuguese.
eightball-language-en = English
eightball-language-es = Spanish
eightball-language-pt = Portuguese
eightball-option-power-assistance = Power assistance: { $enabled }
eightball-option-power-assistance-changed = Power assistance { $enabled }.
eightball-option-power-assistance-description = When enabled, aiming and power controls say whether the selected power is sufficient and report the calculated minimum. Disable it for a more challenging experience.
eightball-option-table-size = Table size: { $table_size }
eightball-option-table-size-prompt = Choose the table size
eightball-option-table-size-changed = Table size set to { $table_size }.
eightball-option-table-size-description = The compact bar surface is 78 by 39 inches, tournament is 92 by 46, and professional is 100 by 50. Balls remain 2.25 inches and every option uses the same regulation-model pocket mouths.
eightball-table-size-7ft = Compact bar table
eightball-table-size-8ft = Tournament table
eightball-table-size-9ft = Professional table
eightball-mode-player-count = This mode requires exactly { $required } active players.
eightball-mode-rules-eightball_singles = Eight-Ball Singles: one against one under WPA Eight-Ball rules. Call the ball and pocket on every non-break shot.
eightball-mode-rules-eightball_doubles = Eight-Ball Doubles: two against two under WPA Eight-Ball rules. Partners alternate shots. The host may arrange or swap the teams before the match.
eightball-mode-rules-cutthroat_five = Five-player Cutthroat under the published BCA rules. Each player protects three numbered balls and shoots opponents' balls. This table uses the permitted no-call version, so B and P are not used.
eightball-cutthroat-group-you = You protect balls { $balls }.
eightball-cutthroat-group-player = { $player } protects balls { $balls }.
