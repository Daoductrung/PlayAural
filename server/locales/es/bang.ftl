game-name-bang = ¡BANG! La Bala

bang-role-sheriff = Sheriff
bang-role-deputy = Alguacil
bang-role-outlaw = Forajido
bang-role-renegade = Renegado
bang-role-hidden = rol oculto

bang-card-label = { $card }, { $playing_card }
bang-card-detail = { $card }. { $description }
bang-card-detail-bang = Carta de disparo: { $card}. { $description }
bang-card-detail-weapon = Arma para equipar: { $card}. { $description }
bang-card-bang = ¡BANG!
bang-card-bang-description = Carta de disparo marrón. Dispara a un jugador dentro del alcance de tu arma actual. Normalmente solo se puede jugar un ¡BANG! por turno.
bang-card-barrel = Barril
bang-card-barrel-description = Carta azul. Cuando un disparo te tiene como objetivo, cada Barril activo puede hacer una verificación de robo; Corazones aporta un efecto ¡Fallaste!.
bang-card-beer = Cerveza
bang-card-beer-description = Recupera una vida, incluso al salvarte a ti mismo con cero vidas. Con la vida al máximo, o cuando solo quedan dos jugadores, puedes jugar Cerveza pero se descarta sin efecto.
bang-card-bible = Biblia
bang-card-bible-description = Carta verde. Colócala frente a ti. A partir de un turno posterior, descártala como un efecto ¡Fallaste!, luego roba una carta.
bang-card-binocular = Prismáticos
bang-card-binocular-description = Carta azul. Ves a todos los demás jugadores a una distancia reducida en uno, con un mínimo de uno.
bang-card-brawl = Riña
bang-card-brawl-description = Descarta una carta de mano adicional, luego haz que cada uno de los demás jugadores descarte una carta en juego elegida o una carta de mano al azar.
bang-card-buffalo-rifle = Rifle de Búfalo
bang-card-buffalo-rifle-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a cualquier otro jugador para dispararle, sin importar la distancia.
bang-card-can-can = Can Can
bang-card-can-can-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a cualquier otro jugador para que pierda una carta en juego elegida o una carta de mano al azar.
bang-card-canteen = Cantimplora
bang-card-canteen-description = Carta verde. Colócala frente a ti. A partir de un turno posterior, descártala para recuperar una vida.
bang-card-cat-balou = Cat Balou
bang-card-cat-balou-description = Haz que cualquier otro jugador descarte una carta en juego elegida o una carta de mano al azar, sin importar la distancia.
bang-card-conestoga = Conestoga
bang-card-conestoga-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a cualquier otro jugador para tomarle una carta en juego elegida o una carta de mano al azar.
bang-card-derringer = Derringer
bang-card-derringer-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a un jugador a distancia uno para dispararle; después de resolver el disparo, roba una carta.
bang-card-dodge = Esquivar
bang-card-dodge-description = Juégala como un efecto ¡Fallaste! contra un disparo, luego roba una carta.
bang-card-duel = Duelo
bang-card-duel-description = Desafía a cualquier otro jugador. El objetivo responde primero; alternen descartando cartas ¡BANG! hasta que un jugador se detenga y pierda una vida.
bang-card-dynamite = Dinamita
bang-card-dynamite-description = Carta azul. Al inicio del turno, Picas del 2 al 9 explota causando tres vidas de daño; en cualquier otro caso, la Dinamita pasa al siguiente jugador en sentido horario que aún no la tenga.
bang-card-gatling = Gatling
bang-card-gatling-description = Dispara a todos los demás jugadores. Cada objetivo debe aportar un efecto ¡Fallaste! o perder una vida.
bang-card-general-store = Emporio
bang-card-general-store-description = Revela una carta por cada jugador actualmente en juego, incluyendo un fantasma activo de Pueblo Fantasma. Empezando por ti y siguiendo en sentido horario, cada jugador elige una.
bang-general-store-reveals = El Emporio revela { $count } cartas: { $cards}.
bang-you-take-general-store-card = Tomas { $card } del Emporio.
bang-player-takes-general-store-card = { $player } toma { $card } del Emporio.
bang-card-hideout = Escondite
bang-card-hideout-description = Carta azul. Todos los demás jugadores te ven a una distancia aumentada en uno.
bang-card-howitzer = Obús
bang-card-howitzer-description = Carta verde. Colócala frente a ti. A partir de un turno posterior, descártala para disparar a todos los demás jugadores; cada uno necesita un efecto ¡Fallaste!.
bang-card-indians = ¡Indios!
bang-card-indians-description = Todos los demás jugadores deben descartar una carta ¡BANG! o perder una vida.
bang-card-iron-plate = Placa de Hierro
bang-card-iron-plate-description = Carta verde. Colócala frente a ti. A partir del turno del siguiente jugador, descártala como un efecto ¡Fallaste!.
bang-card-jail = Cárcel
bang-card-jail-description = Carta azul colocada sobre otro jugador; el Sheriff es inmune excepto en una partida de tres jugadores. Al inicio del turno de ese jugador, Corazones elimina la Cárcel sin consecuencias; cualquier otro resultado hace que pierda el turno.
bang-card-knife = Cuchillo
bang-card-knife-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a un jugador a distancia uno para apuñalarlo; el objetivo necesita un efecto ¡Fallaste!.
bang-card-missed = ¡Fallaste!
bang-card-missed-description = Juégala como un efecto ¡Fallaste! cuando un disparo requiera una respuesta.
bang-card-mustang = Mustang
bang-card-mustang-description = Carta azul. Todos los demás jugadores te ven a una distancia aumentada en uno.
bang-card-panic = ¡Pánico!
bang-card-panic-description = Toma una carta en juego elegida o una carta de mano al azar de un jugador a distancia uno.
bang-card-pepperbox = Pepperbox
bang-card-pepperbox-description = Carta verde. Colócala sin elegir un objetivo. En un turno posterior, descártala y elige a un jugador dentro del alcance de tu arma actual para dispararle.
bang-card-pony-express = Pony Express
bang-card-pony-express-description = Carta verde. Colócala frente a ti. A partir de un turno posterior, descártala para robar tres cartas.
bang-card-punch = Puñetazo
bang-card-punch-description = Golpea a un jugador a distancia uno; el objetivo necesita un efecto ¡Fallaste! o pierde una vida.
bang-card-rag-time = Rag Time
bang-card-rag-time-description = Descarta una carta de mano adicional, luego toma una carta en juego o una carta de mano al azar de cualquier otro jugador.
bang-card-remington = Remington
bang-card-remington-description = Arma azul. Equípala para alcance 3.
bang-card-rev-carabine = Carabina Rev.
bang-card-rev-carabine-description = Arma azul. Equípala para alcance 4.
bang-card-saloon = Saloon
bang-card-saloon-description = Todo jugador actualmente en juego recupera una vida, hasta su máximo.
bang-card-schofield = Schofield
bang-card-schofield-description = Arma azul. Equípala para alcance 2.
bang-card-scope = Catalejo
bang-card-scope-description = Carta azul. Ves a todos los demás jugadores a una distancia reducida en uno, con un mínimo de uno.
bang-card-sombrero = Sombrero
bang-card-sombrero-description = Carta verde. Colócala frente a ti. A partir del turno del siguiente jugador, descártala como un efecto ¡Fallaste!.
bang-card-springfield = Springfield
bang-card-springfield-description = Descarta una carta de mano adicional para dispararle a cualquier otro jugador sin importar la distancia.
bang-card-stagecoach = Diligencia
bang-card-stagecoach-description = Roba dos cartas.
bang-card-ten-gallon-hat = Sombrero de Diez Galones
bang-card-ten-gallon-hat-description = Carta verde. Colócala frente a ti. A partir del turno del siguiente jugador, descártala como un efecto ¡Fallaste!.
bang-card-tequila = Tequila
bang-card-tequila-description = Descarta una carta de mano adicional para que cualquier jugador actualmente en juego, incluyéndote a ti, recupere una vida.
bang-card-volcanic = Volcánica
bang-card-volcanic-description = Arma azul. Equípala para alcance 1 y cualquier número de cartas ¡BANG! durante tu turno.
bang-card-wells-fargo = Wells Fargo
bang-card-wells-fargo-description = Roba tres cartas.
bang-card-whisky = Whisky
bang-card-whisky-description = Descarta una carta de mano adicional para recuperar dos vidas.
bang-card-winchester = Winchester
bang-card-winchester-description = Arma azul. Equípala para alcance 5.

bang-character-bart-cassidy = Bart Cassidy
bang-character-bart-cassidy-ability = Después de sobrevivir a un daño, roba una carta por cada punto de vida perdido.
bang-character-black-jack = Black Jack
bang-character-black-jack-ability = Revela la segunda carta robada de la fase uno; con Corazones o Diamantes, roba una carta extra.
bang-character-calamity-janet = Calamity Janet
bang-character-calamity-janet-ability = Usa ¡BANG! como ¡Fallaste! y ¡Fallaste! como ¡BANG!.
bang-character-el-gringo = El Gringo
bang-character-el-gringo-ability = Después de sobrevivir a un daño causado por un jugador, toma una carta al azar de ese jugador por cada vida perdida.
bang-character-jesse-jones = Jesse Jones
bang-character-jesse-jones-ability = La primera carta robada de la fase uno puede tomarse al azar de la mano de otro jugador.
bang-character-jourdonnais = Jourdonnais
bang-character-jourdonnais-ability = Siempre tiene un Barril virtual, que se acumula con un Barril real.
bang-character-kit-carlson = Kit Carlson
bang-character-kit-carlson-ability = Mira las tres cartas superiores, roba la cantidad requerida, y devuelve el resto sin cambiar su orden.
bang-character-lucky-duke = Lucky Duke
bang-character-lucky-duke-ability = Revela dos cartas en cada verificación de robo y elige el resultado que prefieras.
bang-character-paul-regret = Paul Regret
bang-character-paul-regret-ability = Los demás jugadores lo ven a una distancia aumentada en uno.
bang-character-pedro-ramirez = Pedro Ramirez
bang-character-pedro-ramirez-ability = La primera carta robada de la fase uno puede venir de la cima de la pila de descarte.
bang-character-rose-doolan = Rose Doolan
bang-character-rose-doolan-ability = Ve a todos los demás jugadores a una distancia reducida en uno.
bang-character-sid-ketchum = Sid Ketchum
bang-character-sid-ketchum-ability = Entre efectos ya resueltos, incluso fuera de su turno o durante su propia recuperación letal, descarta exactamente dos cartas de mano para recuperar una vida.
bang-character-slab-the-killer = Slab the Killer
bang-character-slab-the-killer-ability = Sus cartas ¡BANG! requieren dos efectos ¡Fallaste!.
bang-character-suzy-lafayette = Suzy Lafayette
bang-character-suzy-lafayette-ability = Roba una carta cada vez que su mano queda vacía al terminar el efecto actual.
bang-character-vulture-sam = Vulture Sam
bang-character-vulture-sam-ability = Recoge las cartas de cada personaje eliminado.
bang-character-willy-the-kid = Willy the Kid
bang-character-willy-the-kid-ability = Puede jugar cualquier número de cartas ¡BANG!.
bang-character-apache-kid = Apache Kid
bang-character-apache-kid-ability = Las cartas de Diamantes jugadas por otros jugadores no le afectan, excepto durante un Duelo.
bang-character-belle-star = Belle Star
bang-character-belle-star-ability = Durante su turno, las cartas frente a los demás jugadores no tienen efecto.
bang-character-bill-noface = Bill Noface
bang-character-bill-noface-ability = Roba una carta más una por cada herida actual en la fase uno.
bang-character-chuck-wengam = Chuck Wengam
bang-character-chuck-wengam-ability = Durante su turno, pierde una vida no final para robar dos cartas.
bang-character-doc-holyday = Doc Holyday
bang-character-doc-holyday-ability = Una vez por turno, descarta dos cartas de mano para un efecto ¡BANG! dentro del alcance de su arma.
bang-character-elena-fuente = Elena Fuente
bang-character-elena-fuente-ability = Puede usar cualquier carta de mano como ¡Fallaste!.
bang-character-greg-digger = Greg Digger
bang-character-greg-digger-ability = Recupera dos vidas cada vez que otro personaje es eliminado.
bang-character-herb-hunter = Herb Hunter
bang-character-herb-hunter-ability = Roba dos cartas cada vez que otro personaje es eliminado.
bang-character-jose-delgado = José Delgado
bang-character-jose-delgado-ability = Hasta dos veces por turno, descarta una carta azul de mano para robar dos cartas.
bang-character-molly-stark = Molly Stark
bang-character-molly-stark-ability = Fuera de su turno, roba una carta de reemplazo después de jugar o descartar voluntariamente ¡BANG!, ¡Fallaste!, o Cerveza desde la mano. Las cartas ya en juego no cuentan.
bang-character-pat-brennan = Pat Brennan
bang-character-pat-brennan-ability = En lugar del robo normal de la fase uno, toma exactamente una carta en juego.
bang-character-pixie-pete = Pixie Pete
bang-character-pixie-pete-ability = Roba tres cartas en la fase uno.
bang-character-sean-mallory = Sean Mallory
bang-character-sean-mallory-ability = Su límite de mano al final del turno es diez.
bang-character-tequila-joe = Tequila Joe
bang-character-tequila-joe-ability = Cada Cerveza que juega restaura dos vidas en lugar de una.
bang-character-vera-custer = Vera Custer
bang-character-vera-custer-ability = Al inicio de su turno, copia a otro personaje vivo hasta su siguiente turno.
bang-character-claus-the-saint = Claus "El Santo"
bang-character-claus-the-saint-ability = Roba una carta más que los jugadores actualmente en juego, da una a cada uno de los demás jugadores, y se queda con dos.
bang-character-johnny-kisch = Johnny Kisch
bang-character-johnny-kisch-ability = Cuando coloca una carta en juego, descarta todas las demás cartas en juego con ese mismo nombre.
bang-character-uncle-will = Uncle Will
bang-character-uncle-will-ability = Una vez por turno, usa cualquier carta de mano como Emporio.

bang-event-blessing = Bendición
bang-event-blessing-description = El palo de cada carta es Corazones.
bang-event-curse = Maldición
bang-event-curse-description = El palo de cada carta es Picas.
bang-event-ghost-town = Pueblo Fantasma
bang-event-ghost-town-description = Los jugadores eliminados regresan como fantasmas durante sus turnos, roban tres cartas, no pueden ser eliminados durante ese turno, y luego abandonan el juego de nuevo. Los fantasmas aún pueden recuperar vida.
bang-event-gold-rush = Fiebre del Oro
bang-event-gold-rush-description = Los turnos normales avanzan en sentido antihorario; los efectos explícitamente en sentido horario no cambian.
bang-event-hangover = Resaca
bang-event-hangover-description = Las habilidades de personaje no funcionan.
bang-event-high-noon = Sólo ante el peligro
bang-event-high-noon-description = Cada jugador pierde una vida al inicio de su turno.
bang-event-shootout = Tiroteo
bang-event-shootout-description = Un jugador puede jugar una segunda carta ¡BANG! durante su turno.
bang-event-the-daltons = Los Dalton
bang-event-the-daltons-description = Al revelarse, cada jugador con cartas azules en juego descarta una de ellas.
bang-event-the-doctor = El Doctor
bang-event-the-doctor-description = Al revelarse, todo jugador vivo empatado con la vida más baja recupera una vida.
bang-event-the-reverend = El Reverendo
bang-event-the-reverend-description = No se pueden jugar cartas de Cerveza.
bang-event-the-sermon = El Sermón
bang-event-the-sermon-description = El jugador activo no puede usar cartas ¡BANG!, incluyendo respuestas ¡BANG! durante un Duelo.
bang-event-thirst = Sed
bang-event-thirst-description = Roba una carta menos en la fase uno.
bang-event-train-arrival = Llegada del Tren
bang-event-train-arrival-description = Roba una carta adicional en la fase uno.
bang-event-handcuffs = Esposas
bang-event-handcuffs-description = Después de robar, el jugador activo declara un palo y solo puede jugar cartas de ese palo durante el turno; las respuestas de los demás jugadores no tienen restricción.
bang-event-new-identity = Nueva Identidad
bang-event-new-identity-description = Al inicio del turno, opcionalmente conviértete en tu personaje alternativo público con dos vidas.
bang-event-fistful-of-cards = Por un puñado de cartas
bang-event-fistful-of-cards-description = Al inicio del turno, enfrenta un ¡BANG! evitable por cada carta en tu mano.
bang-event-abandoned-mine = Mina Abandonada
bang-event-abandoned-mine-description = Las cartas robadas en la fase uno provienen de los descartes; las cartas sobrantes al final del turno van boca abajo sobre la pila de robo.
bang-event-ambush = Emboscada
bang-event-ambush-description = La distancia base entre cada dos jugadores es uno; los modificadores siguen aplicándose.
bang-event-blood-brothers = Hermanos de Sangre
bang-event-blood-brothers-description = Al inicio del turno, opcionalmente pierde una vida no final para curar a otro jugador en una vida.
bang-event-dead-man = El Muerto
bang-event-dead-man-description = El primer jugador eliminado regresa una vez, en su siguiente turno, con dos vidas y dos cartas, y luego roba con normalidad.
bang-event-hard-liquor = Licor Fuerte
bang-event-hard-liquor-description = Un jugador puede saltarse la fase uno para recuperar una vida.
bang-event-lasso = Lazo
bang-event-lasso-description = Las cartas en juego no tienen efecto.
bang-event-law-of-the-west = La Ley del Oeste
bang-event-law-of-the-west-description = Revela la segunda carta de la fase uno y juégala durante la fase dos si es posible.
bang-event-peyote = Peyote
bang-event-peyote-description = En lugar de robar, adivina repetidamente rojo o negro; conserva las cartas acertadas y detente al fallar.
bang-event-ranch = Rancho
bang-event-ranch-description = Una vez después de la fase uno, descarta cualquier cantidad de cartas de mano y roba la misma cantidad.
bang-event-ricochet = Rebote
bang-event-ricochet-description = Descarta cartas ¡BANG! para atacar cartas en juego a cualquier distancia; un efecto ¡Fallaste! salva cada carta.
bang-event-russian-roulette = Ruleta Rusa
bang-event-russian-roulette-description = Empezando por el Sheriff, o el Alguacil en partidas de tres jugadores, avanza en sentido horario y evita un disparo cada uno; el primer fallo pierde dos vidas y la detiene.
bang-event-sniper = Francotirador
bang-event-sniper-description = Descarta dos cartas ¡BANG! para un disparo alcanzable que requiere dos ¡Fallaste!.
bang-event-the-judge = El Juez
bang-event-the-judge-description = Ningún jugador puede colocar una carta azul o verde en juego.
bang-event-vendetta = Vendetta
bang-event-vendetta-description = Al final del turno, una verificación de robo de Corazones otorga un turno extra; el turno extra no vuelve a verificar.

bang-event-mode-none = Desactivado — turnos estándar
bang-event-mode-high-noon = Conjunto Sólo ante el peligro — 14 eventos, luego daño al inicio del turno
bang-event-mode-fistful = Conjunto Por un puñado de cartas — 14 eventos, luego disparos según el tamaño de la mano
bang-event-mode-combined = Conjunto Mixto — 12 eventos, luego un final aleatorio
bang-option-expanded-cards = Cartas y personajes expandidos: { $enabled }
bang-option-expanded-cards-description = Activado, por defecto: 120 cartas, los 34 personajes, cartas verdes de uso diferido, y de 3 a 8 jugadores. Desactivado: 80 cartas, 19 personajes, sin cartas verdes, y de 4 a 7 jugadores. Los eventos son independientes.
bang-option-changed-expanded-cards = Las cartas y personajes expandidos ahora están { $enabled }.
bang-option-event-rules = Eventos de cambio de turno: { $mode }
bang-option-event-rules-prompt = Elige si y cómo los eventos cambian las reglas en cada ronda.
bang-option-event-rules-description = Mixto es la opción por defecto. A partir de la ronda dos, un evento cambia las reglas hasta el siguiente. Un conjunto completo tiene 14 eventos barajados y su final duradero; Mixto tiene 12 eventos y un final aleatorio. Desactivado mantiene los turnos estándar.
bang-option-changed-event-rules = Los eventos de cambio de turno ahora están { $mode }.

bang-action-confirm = Confirmar selección
bang-action-unknown = acción no disponible
bang-action-cancel = Cancelar acción
bang-action-canceled = { $action } cancelada; todas las cartas permanecen en su lugar.
bang-action-end-turn = Terminar turno
bang-action-sid-ketchum = Usar a Sid Ketchum
bang-action-doc-holyday = Usar a Doc Holyday
bang-action-chuck-wengam = Usar a Chuck Wengam
bang-action-jose-delgado = Usar a José Delgado
bang-action-uncle-will = Usar a Uncle Will
bang-action-sniper = Usar Francotirador
bang-action-ricochet = Usar Rebote
bang-action-read-hand = Leer tu mano
bang-action-read-role = Leer tu rol y personaje
bang-action-read-life = Leer tu vida
bang-action-read-distances = Leer distancias
bang-action-read-piles = Leer las pilas de cartas
bang-action-read-event = Leer el evento actual
bang-action-read-table = Leer la mesa
bang-keybind-end-or-confirm = Terminar turno o confirmar una selección múltiple
bang-use-card = Usar { $card }
bang-choose-player = { $player }, { $life } vidas, { $cards ->
    [one] 1 carta en mano
   *[other] { $cards } cartas en mano
}
bang-in-play-choice = { $player }: { $card }
bang-menu-instruction = Siguiente: { $instruction }
bang-discard-card-selected = Seleccionada para descartar: { $card }
bang-discard-card-unselected = No seleccionada para descartar: { $card }
bang-selected-card = Seleccionada: { $card }
bang-unselected-card = No seleccionada: { $card }
bang-response-card = Responde con { $card }
bang-card-selected = Seleccionaste { $card }.
bang-card-unselected = Deseleccionaste { $card }.
bang-card-selected-progress = Seleccionaste { $card}. { $remaining ->
    [0] Listo para confirmar.
    [one] Elige 1 más.
   *[other] Elige { $remaining } más.
}
bang-card-unselected-progress = Deseleccionaste { $card}. { $remaining ->
    [one] Elige 1 más.
   *[other] Elige { $remaining } más.
}
bang-card-selected-for-discard = Descartarás { $card}. { $remaining ->
    [0] Listo para confirmar.
    [one] Elige 1 más.
   *[other] Elige { $remaining } más.
}
bang-card-removed-from-discard = Conservarás { $card}. { $remaining ->
    [one] Elige 1 carta más para descartar.
   *[other] Elige { $remaining } cartas más para descartar.
}
bang-confirm-required-pending = Confirmar selección — { $remaining ->
    [one] elige 1 carta más
   *[other] elige { $remaining } cartas más
}
bang-confirm-required-ready = Confirmar selección — { $selected } seleccionadas
bang-confirm-discard-pending = Confirmar descarte — { $remaining ->
    [one] elige 1 carta más
   *[other] elige { $remaining } cartas más
}
bang-confirm-discard-ready = Confirmar descarte — { $selected } seleccionadas
bang-confirm-ranch = { $selected ->
    [0] Conserva tu mano; no intercambies cartas
    [one] Confirmar intercambio de Rancho — 1 carta
   *[other] Confirmar intercambio de Rancho — { $selected } cartas
}
bang-confirm-discard-order = { $selected ->
    [0] Confirmar el orden de descarte actual
    [one] Confirmar orden de descarte — 1 carta primero
