game-name-battle = Pertempuran

battle-set-game-mode = Mode permainan: { $mode }
battle-select-game-mode = Pilih mode permainan:
battle-option-changed-game-mode = Mode permainan diubah menjadi { $mode }.
battle-desc-game-mode = Memilih format Pertempuran: jumlah petarung tetap, Pertempuran Tim, Chaos Free For All, Spitting Image, Arena, Bertahan Hidup, atau Gelombang.
battle-desc-team-mode = Memilih permainan individu atau jumlah anggota tim yang tetap. Pengaturan ini digunakan dalam Pertempuran Tim dan harus sesuai dengan jumlah pemain saat ini.
battle-set-turn-mode = Urutan giliran: { $mode }
battle-select-turn-mode = Pilih urutan giliran:
battle-option-changed-turn-mode = Urutan giliran diubah menjadi { $mode }.
battle-desc-turn-mode = Memilih urutan giliran. Inisiatif mengurutkan petarung berdasarkan kecepatan setiap ronde, sedangkan Bergiliran Tetap mengikuti urutan yang tetap.
battle-set-balance-mode = Mode seimbang: { $enabled }
battle-option-changed-balance-mode = Mode seimbang diubah menjadi { $enabled }.
battle-desc-balance-mode = Jika diaktifkan, petarung yang nilainya berbeda dari nilai dasar seimbang akan diatur ulang sebelum pertempuran. Nilainya menjadi 50 kesehatan, 0 serangan, 0 pertahanan, dan 100 kecepatan.
battle-set-unlimited-selection-limit = Batas petarung untuk mode pilihan bebas: { $count }
battle-enter-unlimited-selection-limit = Masukkan batas petarung untuk mode pilihan bebas:
battle-option-changed-unlimited-selection-limit = Batas petarung untuk mode pilihan bebas diubah menjadi { $count }.
battle-desc-unlimited-selection-limit = Jumlah maksimum petarung yang boleh dipilih setiap pemain dalam mode pilihan bebas, seperti Chaos Free For All, Pertempuran Tim, Arena, Bertahan Hidup, dan Gelombang. Nilai awal 3, dapat diatur dari 1 hingga 6.
battle-set-classic-enemy-preset = Jenis musuh klasik: { $preset }
battle-select-classic-enemy-preset = Pilih jenis musuh klasik:
battle-option-changed-classic-enemy-preset = Jenis musuh klasik diubah menjadi { $preset }.
battle-desc-classic-enemy-preset = Memilih satu jenis musuh yang digunakan dalam Arena Klasik, Bertahan Hidup Klasik, dan Gelombang Klasik.
battle-set-arena-difficulty = Kesulitan arena: { $difficulty }
battle-select-arena-difficulty = Pilih kesulitan arena:
battle-option-changed-arena-difficulty = Kesulitan arena diubah menjadi { $difficulty }.
battle-desc-arena-difficulty = Mengatur kekuatan musuh yang muncul dalam Arena, Bertahan Hidup, dan Gelombang, dari Mudah hingga Ultimate.
battle-set-survival-target = Target bertahan hidup: { $count }
battle-enter-survival-target = Masukkan target bertahan hidup, atau 0 untuk tanpa batas:
battle-option-changed-survival-target = Target bertahan hidup diubah menjadi { $count }.
battle-desc-survival-target = Jumlah musuh yang harus dikalahkan dalam Bertahan Hidup atau Gelombang. Atur ke 0 untuk bermain tanpa batas jumlah musuh. Dapat diatur dari 0 hingga 10000.
battle-set-survival-heal-percent = Persentase pemulihan saat bertahan hidup: { $percent }
battle-enter-survival-heal-percent = Masukkan persentase pemulihan saat bertahan hidup:
battle-option-changed-survival-heal-percent = Persentase pemulihan saat bertahan hidup diubah menjadi { $percent }.
battle-desc-survival-heal-percent = Persentase kesehatan maksimum yang dipulihkan oleh petarung sekutu yang masih hidup setiap kali musuh pengganti muncul dalam Bertahan Hidup atau satu gelombang dikalahkan. Nilai awal 0 persen, dapat diatur dari 0 hingga 100.

