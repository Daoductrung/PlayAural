game-name-deadmansdice = Dead Man's Dice

deadmansdice-set-rules = Aturan: { $rules }
deadmansdice-select-rules = Pilih aturan
deadmansdice-option-changed-rules = Aturan diubah menjadi { $rules }.
deadmansdice-rules-traditional = Tradisional
deadmansdice-rules-basic = Dasar
deadmansdice-rules-unsupported = Tidak didukung
deadmansdice-rules-description = Dalam aturan Tradisional, angka satu juga dihitung sebagai angka dua hingga enam. Dalam aturan Dasar, setiap angka hanya dihitung sesuai nilainya. Keduanya mengizinkan seruan Tepat Sekali.

deadmansdice-call-liar = Tuduh berbohong
deadmansdice-call-liar-description = Tantang tebakan terakhir. Jika jumlah yang ditebak terlalu tinggi, penebaknya meminum racun. Jika tidak, Anda yang meminumnya.
deadmansdice-call-liar-current = Tuduh berbohong: { $quantity } { $face }
deadmansdice-call-liar-current-description = Tantang tebakan { $quantity } { $face }. Jika jumlahnya terlalu tinggi, penebaknya meminum racun. Jika tidak, Anda yang meminumnya.
deadmansdice-call-spot-on = Serukan Tepat Sekali
deadmansdice-call-spot-on-description = Nyatakan bahwa tebakan terakhir tepat. Jika benar, semua pemain lain yang masih bertahan meminum racun. Jika salah, Anda yang meminumnya.
deadmansdice-call-spot-on-current = Serukan Tepat Sekali: tepat { $quantity } { $face }
deadmansdice-call-spot-on-current-description = Nyatakan bahwa ada tepat { $quantity } { $face }. Jika benar, semua pemain lain yang masih bertahan meminum racun. Jika salah, Anda yang meminumnya.
deadmansdice-bid-face = Tebak { $face }
deadmansdice-bid-face-minimum = Tebak { $face }: minimal { $minimum }
deadmansdice-bid-face-description = Pilih jumlah { $face } yang Anda tebak ada di seluruh meja.
deadmansdice-select-bid-quantity = Pilih jumlah dadu yang ditebak
deadmansdice-select-bid-quantity-for-face = Menebak { $face }. Pilih jumlahnya.
deadmansdice-bid-option = { $quantity } { $face }
deadmansdice-read-dice = Dengarkan dadu Anda
deadmansdice-read-dice-description = Dengarkan kembali kelima dadu Anda yang tersembunyi.
deadmansdice-read-table = Tinjau meja
deadmansdice-read-table-description = Tinjau ronde, aturan, tebakan terakhir, giliran, dan dosis racun setiap pemain.
deadmansdice-review-bids = Tinjau tebakan
deadmansdice-review-bids-description = Tinjau semua tebakan dalam ronde ini secara berurutan.
deadmansdice-review-last-reveal = Tinjau pembukaan terakhir
deadmansdice-review-last-reveal-description = Tinjau semua dadu yang dibuka dan hasil tantangan sebelumnya.

deadmansdice-face-1 = dadu berangka satu
deadmansdice-face-2 = dadu berangka dua
deadmansdice-face-3 = dadu berangka tiga
deadmansdice-face-4 = dadu berangka empat
deadmansdice-face-5 = dadu berangka lima
deadmansdice-face-6 = dadu berangka enam
deadmansdice-face-1-singular = satu
deadmansdice-face-2-singular = dua
deadmansdice-face-3-singular = tiga
deadmansdice-face-4-singular = empat
deadmansdice-face-5-singular = lima
deadmansdice-face-6-singular = enam

deadmansdice-intro = Suasana kedai terasa menyesakkan. Cangkir diletakkan. Hanya satu dari kalian yang akan keluar hidup-hidup.
deadmansdice-match-setup-traditional = { $players } pemain. Aturan: { $rules }. Angka satu juga dihitung sebagai angka dua hingga enam. Tebakan angka satu hanya menghitung dadu yang benar-benar berangka satu.
deadmansdice-match-setup-basic = { $players } pemain. Aturan: { $rules }. Setiap angka hanya dihitung sesuai nilainya, termasuk angka satu.
deadmansdice-match-setup-unsupported = Permainan tidak dapat dimulai karena aturannya sudah tidak didukung.
deadmansdice-round-start = Ronde { $round }. { $players } pemain yang masih bertahan menutupi { $dice } dadu dengan cangkir mereka.
deadmansdice-your-dice = Dadu Anda: { $dice }.
deadmansdice-you-bid = Anda menebak { $quantity } { $face }.
deadmansdice-player-bids = { $player } menebak { $quantity } { $face }.
deadmansdice-you-call-liar = Anda menuduh { $bidder } berbohong atas tebakan { $quantity } { $face }.
deadmansdice-player-calls-liar = { $player } menuduh { $bidder } berbohong atas tebakan { $quantity } { $face }.
deadmansdice-you-call-spot-on = Anda menyerukan Tepat Sekali atas tebakan { $bidder }, yaitu { $quantity } { $face }.
deadmansdice-player-calls-spot-on = { $player } menyerukan Tepat Sekali atas tebakan { $bidder }, yaitu { $quantity } { $face }.
deadmansdice-your-cup-reveals = Cangkir Anda diangkat: { $dice }.
deadmansdice-player-cup-reveals = Cangkir { $player } diangkat: { $dice }.
deadmansdice-reveal-total = Jumlah dadu yang cocok dengan tebakan adalah { $actual }. Tebakannya adalah { $quantity } { $face }.
deadmansdice-your-bid-too-high = Jumlah dadu yang cocok lebih sedikit daripada tebakan Anda. Anda kalah dalam tantangan ini.
deadmansdice-player-bid-too-high = Jumlah dadu yang cocok lebih sedikit daripada tebakan { $player }. { $player } kalah dalam tantangan ini.
deadmansdice-you-challenged-truth = Jumlah dadu yang cocok memenuhi tebakan. Anda kalah dalam tantangan ini.
deadmansdice-player-challenged-truth = Jumlah dadu yang cocok memenuhi tebakan. { $player } kalah dalam tantangan ini.
deadmansdice-your-spot-on-correct = Seruan Tepat Sekali Anda benar. Semua pemain lain harus minum racun.
deadmansdice-player-spot-on-correct = Seruan { $player } tepat. Semua pemain lain harus minum racun.
deadmansdice-your-spot-on-wrong = Seruan Tepat Sekali Anda salah. Anda harus minum racun.
deadmansdice-player-spot-on-wrong = Seruan { $player } meleset dari jumlah yang tepat. Ia harus minum racun.
deadmansdice-you-drink-poison = Anda menelan racun. Dosis { $doses } dari { $maximum }.
deadmansdice-player-drinks-poison = { $player } menelan racun. Dosis { $doses } dari { $maximum }.
deadmansdice-you-eliminated = Dosis kedua merenggut nyawa Anda. Anda tersingkir.
deadmansdice-player-eliminated = Dosis kedua merenggut nyawa { $player }. { $player } tersingkir.
deadmansdice-you-win = Anda satu-satunya yang masih hidup. Anda memenangkan Dead Man's Dice.
deadmansdice-player-wins = { $player } satu-satunya yang masih hidup dan memenangkan Dead Man's Dice.

deadmansdice-action-opening = Meja masih disiapkan. Tunggu lemparan pertama.
deadmansdice-action-opening-no-dice = Cangkir Anda masih kosong. Lemparan pembuka belum dimulai.
deadmansdice-action-opening-no-bids = Belum ada yang melempar dadu, jadi belum ada tebakan yang bisa ditinjau.
deadmansdice-action-eliminated = Anda sudah tersingkir dari permainan ini.
deadmansdice-action-no-bid = Belum ada tebakan yang bisa ditantang.
deadmansdice-action-face-unavailable = Tidak ada lagi kenaikan tebakan yang sah untuk angka itu.
deadmansdice-action-invalid-bid = Tebakan itu sudah tidak sah karena keadaan meja telah berubah.
deadmansdice-action-selection-open = Selesaikan atau batalkan pemilihan tebakan yang sedang terbuka terlebih dahulu.
deadmansdice-action-sequence-running = Tantangan masih berlangsung. Tunggu hasil akhirnya.
deadmansdice-action-no-dice = Anda belum memiliki hasil lemparan saat ini yang bisa dibacakan.
deadmansdice-action-no-last-reveal = Belum ada dadu yang dibuka untuk menyelesaikan tantangan.

deadmansdice-table-opening-header = Dead Man's Dice. Meja sedang disiapkan, aturan { $rules }
deadmansdice-table-header = Dead Man's Dice. Ronde { $round }, aturan { $rules }
deadmansdice-table-pool-opening = { $players } pemain menunggu dengan { $dice } dadu yang belum dilempar.
deadmansdice-table-pool =
    { $players ->
        [one] 1 pemain masih bertahan
       *[other] { $players } pemain masih bertahan
    }. Ada { $dice } dadu dalam permainan.
deadmansdice-table-rule-traditional = Angka satu juga dihitung dalam tebakan angka dua hingga enam. Tebakan angka satu hanya menghitung dadu yang benar-benar berangka satu. Seruan Tepat Sekali tersedia.
deadmansdice-table-rule-basic = Setiap angka hanya dihitung sesuai nilainya, termasuk angka satu. Seruan Tepat Sekali tersedia.
deadmansdice-table-rule-unsupported = Aturan yang dipilih tidak didukung. Permainan ini tidak dapat dilanjutkan dengan aman.
deadmansdice-table-current-bid-you = Tebakan terakhir: Anda menebak { $quantity } { $face }.
deadmansdice-table-current-bid = Tebakan terakhir: { $quantity } { $face }, oleh { $player }.
deadmansdice-table-no-bid = Belum ada tebakan dalam ronde ini.
deadmansdice-table-turn-you = Sekarang giliran Anda.
deadmansdice-table-turn = Sekarang giliran { $player }.
deadmansdice-table-no-turn = Belum ada giliran yang aktif.
deadmansdice-table-player-you = Anda: dosis racun { $doses } dari { $maximum }.
deadmansdice-table-player = { $player }: dosis racun { $doses } dari { $maximum }.
deadmansdice-table-player-you-eliminated = Anda: tersingkir.
deadmansdice-table-player-eliminated = { $player }: tersingkir.
deadmansdice-bids-header = Tebakan ronde { $round }
deadmansdice-bids-none = Belum ada tebakan dalam ronde ini.
deadmansdice-bids-line-you = { $index }. Anda: { $quantity } { $face }.
deadmansdice-bids-line = { $index }. { $player }: { $quantity } { $face }.
deadmansdice-last-reveal-header = Pembukaan terakhir, ronde { $round }
deadmansdice-last-reveal-player-you = Anda: { $dice }.
deadmansdice-last-reveal-player = { $player }: { $dice }.
deadmansdice-last-reveal-pending = Cangkir masih diangkat satu per satu.
deadmansdice-last-reveal-result = Tebakan: { $quantity } { $face }. Jumlah dadu yang cocok: { $actual }. { $result }
deadmansdice-last-result-liar-bidder-lost-you = Tebakan Anda terlalu tinggi. Anda kalah dalam tantangan itu.
deadmansdice-last-result-liar-challenger-lost-you = Jumlah dadu yang cocok memenuhi tebakan. Anda kalah dalam tantangan itu.
deadmansdice-last-result-spot-correct-you = Seruan Tepat Sekali Anda benar. Semua pemain lain meminum racun.
deadmansdice-last-result-spot-wrong-you = Seruan Tepat Sekali Anda salah. Anda meminum racun.
deadmansdice-last-result-liar-bidder-lost = Tebakan terlalu tinggi. { $player } kalah dalam tantangan itu.
deadmansdice-last-result-liar-challenger-lost = Jumlah dadu yang cocok memenuhi tebakan. { $player } kalah dalam tantangan itu.
deadmansdice-last-result-spot-correct = Seruan Tepat Sekali benar. Semua pemain selain { $player } meminum racun.
deadmansdice-last-result-spot-wrong = Seruan Tepat Sekali salah. { $player } meminum racun.
deadmansdice-last-result-unavailable = Hasil tantangan sebelumnya tidak tersedia.

deadmansdice-results-header = Hasil Dead Man's Dice
deadmansdice-results-winner = Pemain terakhir yang bertahan: { $player }.
deadmansdice-results-line = { $player }: { $status }. { $bids } tebakan, { $challenges } tuduhan berbohong, { $spots } seruan Tepat Sekali, { $poison } dosis racun.
deadmansdice-results-survived = bertahan hidup
deadmansdice-results-eliminated = tersingkir
deadmansdice-error-rules-invalid = Aturan yang dipilih tidak didukung.
