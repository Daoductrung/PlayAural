lightturret-player-upgrades-accident = { $player } membayar { $cost } koin, tetapi inti gagal ditingkatkan dan malah menambah { $gain } cahaya. Menaranya kini memiliki { $light } cahaya dari daya { $power }, sisa kapasitas aman { $headroom }, dan { $coins } koin.
lightturret-you-upgrade-accident-brief = Peningkatan Anda gagal. Cahaya bertambah { $gain }. Cahaya { $light } dari daya { $power }, koin { $coins }.
lightturret-player-upgrades-accident-brief = Peningkatan { $player } gagal. Cahaya bertambah { $gain }. Cahaya { $light } dari daya { $power }, koin { $coins }.
lightturret-you-upgrade-overload = Anda membayar { $cost } koin, tetapi inti gagal ditingkatkan dan malah menambah { $gain } cahaya. Cahaya Anda mencapai { $light } dengan daya { $power }, melampaui kapasitas sebesar { $overload }. Anda tersingkir dengan sisa { $coins } koin.
lightturret-player-upgrades-overload = { $player } membayar { $cost } koin, tetapi inti gagal ditingkatkan dan malah menambah { $gain } cahaya. Cahayanya mencapai { $light } dengan daya { $power }, melampaui kapasitas sebesar { $overload }. Pemain ini tersingkir dengan sisa { $coins } koin.
lightturret-you-upgrade-overload-brief = Peningkatan membuat Anda kelebihan beban. Cahaya bertambah { $gain }, kini { $light } dari daya { $power }, kelebihan { $overload }. Anda tersingkir.
lightturret-player-upgrades-overload-brief = Peningkatan membuat { $player } kelebihan beban. Cahaya bertambah { $gain }, kini { $light } dari daya { $power }, kelebihan { $overload }. Pemain ini tersingkir.
lightturret-action-resolving = Tindakan menara Anda masih berlangsung. Tunggu sampai suara dan hasilnya selesai.
lightturret-not-enough-coins = Peningkatan inti membutuhkan { $need } koin, tetapi Anda hanya punya { $have }.
lightturret-you-are-eliminated = Menara Anda kelebihan beban dan Anda tersingkir, jadi Anda tidak bisa bertindak lagi.
lightturret-confirm-risky-shot = Dengan { $light } cahaya dan daya { $power }, menembak sekarang berisiko { $risk }% mengalami kelebihan beban. Tembak lagi dalam { $seconds } detik untuk mengonfirmasi.
lightturret-status-round = Ronde { $round } dari { $total }. Menara aktif: { $alive }.
lightturret-stats-alive = { $player }: { $light } cahaya, daya { $power }, sisa kapasitas aman { $headroom }, { $coins } koin. Risiko kelebihan beban pada tembakan berikutnya { $risk }%.
lightturret-stats-eliminated = { $player }: tersingkir dengan { $light } cahaya dan daya { $power }.
lightturret-end-max-rounds = Seluruh { $total } ronde selesai. Jumlah cahaya akhir menentukan pemenang.
lightturret-end-max-rounds-brief = { $total } ronde selesai.
lightturret-end-all-eliminated = Semua menara kelebihan beban pada ronde { $round }. Jumlah cahaya akhir menentukan pemenang.
lightturret-end-all-eliminated-brief = Semua menara kelebihan beban pada ronde { $round }.
lightturret-you-win = Anda menang dengan { $light } cahaya dan daya { $power }. { $survived ->
    [true] Menara Anda bertahan.
   *[false] Jumlah cahaya akhir Anda tetap tertinggi meskipun kelebihan beban.
}
lightturret-player-wins = { $player } menang dengan { $light } cahaya dan daya { $power }. { $survived ->
    [true] Menaranya bertahan.
   *[false] Jumlah cahaya akhirnya tetap tertinggi meskipun kelebihan beban.
}
lightturret-you-win-brief = Anda menang dengan { $light } cahaya.
lightturret-player-wins-brief = { $player } menang dengan { $light } cahaya.
lightturret-you-tie = Anda berbagi peringkat pertama dengan { $players }, masing-masing memiliki { $light } cahaya.
lightturret-players-tie = { $players } berbagi peringkat pertama dengan { $light } cahaya.
lightturret-you-tie-brief = Anda seri dengan { $players }: { $light } cahaya.
lightturret-players-tie-brief = Seri: { $players }, { $light } cahaya.
lightturret-set-starting-power = Daya awal: { $power }
lightturret-enter-starting-power = Masukkan daya awal:
lightturret-option-changed-power = Daya awal diatur menjadi { $power }.
lightturret-desc-starting-power = Kapasitas awal setiap menara sebelum kelebihan beban. Cahaya yang sama dengan daya masih aman. Kelebihan beban hanya terjadi jika cahaya melampaui daya. Nilai bawaan 10, rentang 5 hingga 30.
lightturret-set-max-rounds = Batas ronde: { $rounds }
lightturret-enter-max-rounds = Masukkan batas ronde:
lightturret-option-changed-rounds = Batas ronde diatur menjadi { $rounds }.
lightturret-desc-max-rounds = Jumlah ronde penuh yang dimainkan. Setiap menara aktif mendapat satu giliran pada ronde terakhir. Nilai bawaan 50, rentang 10 hingga 200.
lightturret-error-starting-power-invalid = Daya awal harus antara { $min } dan { $max }. Nilai saat ini { $power }.
lightturret-error-max-rounds-invalid = Batas ronde harus antara { $min } dan { $max }. Nilai saat ini { $rounds }.
lightturret-status-survived = Aktif
lightturret-status-eliminated = Tersingkir
lightturret-end-winner = Pemenang: { $player } dengan { $light } cahaya.
lightturret-end-tie = Peringkat pertama seri: { $players } dengan { $light } cahaya.
