game-name-lightturret = Light Turret
lightturret-intro = Light Turret dimulai dengan daya { $power } dan { $rounds } ronde penuh. Tembak untuk memperoleh cahaya dan koin sebanyak dua kali cahaya yang didapat. Menara hanya kelebihan beban jika cahayanya melampaui daya. Peningkatan inti membutuhkan { $cost } koin dan bisa gagal.
lightturret-intro-brief = Light Turret. Daya { $power }, { $rounds } ronde, biaya peningkatan { $cost } koin.
lightturret-round-start = Ronde { $round } dari { $total } dimulai dengan { $alive } { $alive ->
    [one] menara aktif
   *[other] menara aktif
}.
lightturret-round-start-brief = Ronde { $round } dari { $total }. Aktif: { $alive }.
lightturret-shoot = Tembakkan menara
lightturret-shoot-safe-label = Tembakkan menara, sisa kapasitas aman { $headroom }
lightturret-shoot-risk-label = Tembakkan menara, risiko kelebihan beban { $risk }%
lightturret-upgrade = Tingkatkan inti
lightturret-upgrade-label = Tingkatkan inti, biaya { $cost } koin, Anda punya { $coins }
lightturret-check-stats = Lihat status menara
lightturret-you-shoot = Anda menembak dan mendapat { $gain } cahaya serta { $coins } koin. Menara Anda kini memiliki { $light } cahaya dari daya { $power }, sisa kapasitas aman { $headroom }, dan { $total_coins } koin.
lightturret-player-shoots = { $player } menembak dan mendapat { $gain } cahaya serta { $coins } koin. Menaranya kini memiliki { $light } cahaya dari daya { $power }, sisa kapasitas aman { $headroom }, dan { $total_coins } koin.
lightturret-you-shoot-brief = Anda menembak. Bertambah { $gain } cahaya dan { $coins } koin. Cahaya { $light } dari daya { $power }, koin { $total_coins }.
lightturret-player-shoots-brief = { $player } menembak. Bertambah { $gain } cahaya dan { $coins } koin. Cahaya { $light } dari daya { $power }, koin { $total_coins }.
lightturret-you-shoot-overload = Anda menembak dan mendapat { $gain } cahaya serta { $coins } koin. Cahaya Anda mencapai { $light } dengan daya { $power }. Anda melampaui kapasitas sebesar { $overload } dan tersingkir dengan sisa { $total_coins } koin.
lightturret-player-shoots-overload = { $player } menembak dan mendapat { $gain } cahaya serta { $coins } koin. Cahayanya mencapai { $light } dengan daya { $power }. Kapasitasnya terlampaui sebesar { $overload } sehingga pemain ini tersingkir dengan sisa { $total_coins } koin.
lightturret-you-shoot-overload-brief = Anda kelebihan beban. Bertambah { $gain } cahaya, kini { $light } dari daya { $power }, kelebihan { $overload }. Anda tersingkir.
lightturret-player-shoots-overload-brief = { $player } kelebihan beban. Bertambah { $gain } cahaya, kini { $light } dari daya { $power }, kelebihan { $overload }. Pemain ini tersingkir.
lightturret-you-upgrade = Anda membayar { $cost } koin dan meningkatkan daya inti sebesar { $gain }. Menara Anda kini memiliki { $light } cahaya, daya { $power }, sisa kapasitas aman { $headroom }, dan { $coins } koin.
lightturret-player-upgrades = { $player } membayar { $cost } koin dan meningkatkan daya inti sebesar { $gain }. Menaranya kini memiliki { $light } cahaya, daya { $power }, sisa kapasitas aman { $headroom }, dan { $coins } koin.
lightturret-you-upgrade-brief = Anda meningkatkan inti. Daya bertambah { $gain }. Cahaya { $light } dari daya { $power }, koin { $coins }.
