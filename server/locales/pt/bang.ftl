    [one] 1 carta na mão
   *[other] { $cards } cartas na mão
}; personagem: { $character }
bang-in-play-choice = { $player }: { $card }
bang-menu-instruction = Próximo: { $instruction }
bang-discard-card-selected = Selecionado para descarte: { $card }
bang-discard-card-unselected = Não selecionado para descarte: { $card }
bang-selected-card = Selecionado: { $card }
bang-unselected-card = Não selecionado: { $card }
bang-response-card = Responder com { $card }
bang-card-selected = { $card } selecionada.
bang-card-unselected = { $card } desselecionada.
