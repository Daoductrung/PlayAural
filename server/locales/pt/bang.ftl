    [one] Escolha mais 1.
   *[other] Escolha mais { $remaining }.
}
bang-card-unselected-progress = { $card } desselecionada. { $remaining ->
    [one] Escolha mais 1.
   *[other] Escolha mais { $remaining }.
}
bang-card-selected-for-discard = Descartará { $card }. { $remaining ->
    [0] Pronto para confirmar.
    [one] Escolha mais 1.
   *[other] Escolha mais { $remaining }.
}
bang-card-removed-from-discard = Manterá { $card }. { $remaining ->
    [one] Escolha mais 1 carta para descartar.
   *[other] Escolha mais { $remaining } cartas para descartar.
}
bang-confirm-required-pending = Confirmar seleção — { $remaining ->
    [one] escolha mais 1 carta
   *[other] escolha mais { $remaining } cartas
}
bang-confirm-required-ready = Confirmar seleção — { $selected } selecionadas
bang-confirm-discard-pending = Confirmar descarte — { $remaining ->
    [one] escolha mais 1 carta
   *[other] escolha mais { $remaining } cartas
}
