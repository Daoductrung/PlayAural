game-name-deadmansdice = Dados do Morto

deadmansdice-set-rules = Regras: { $rules }
deadmansdice-select-rules = Escolha as regras
deadmansdice-option-changed-rules = As regras mudaram para { $rules }.
deadmansdice-rules-traditional = Tradicionais
deadmansdice-rules-basic = Básicas
deadmansdice-rules-unsupported = Não compatíveis
deadmansdice-rules-description = Nas regras tradicionais, os uns são curingas na contagem de dois a seis. Nas regras básicas, cada face é contada literalmente. Os dois conjuntos de regras permitem declarar Exato.

deadmansdice-call-liar = Chamar de mentiroso
deadmansdice-call-liar-description = Desafie o lance atual. Se ele for alto demais, quem deu o lance bebe veneno; caso contrário, você bebe.
deadmansdice-call-liar-current = Chamar de mentiroso — { $quantity } { $face }
deadmansdice-call-liar-current-description = Desafie o lance de { $quantity } { $face }. Se ele for alto demais, quem deu o lance bebe veneno; caso contrário, você bebe.
deadmansdice-call-spot-on = Declarar Exato
deadmansdice-call-spot-on-description = Afirme que o lance atual é exato. Se acertar, todos os outros sobreviventes bebem veneno; se errar, você bebe.
deadmansdice-call-spot-on-current = Declarar Exato — exatamente { $quantity } { $face }
deadmansdice-call-spot-on-current-description = Afirme que há exatamente { $quantity } { $face }. Se acertar, todos os outros sobreviventes bebem veneno; se errar, você bebe.
deadmansdice-bid-face = Dar lance em { $face }
deadmansdice-bid-face-minimum = Dar lance em { $face } — { $minimum } ou mais
deadmansdice-bid-face-description = Escolha uma quantidade e dê o lance de que há essa quantidade de { $face } na mesa inteira.
deadmansdice-select-bid-quantity = Escolha a quantidade do lance
deadmansdice-select-bid-quantity-for-face = Lance em { $face }. Escolha uma quantidade.
deadmansdice-bid-option = { $quantity } { $face }
deadmansdice-read-dice = Ler seus dados
deadmansdice-read-dice-description = Ouça novamente seus cinco dados escondidos.
deadmansdice-read-table = Ler mesa
deadmansdice-read-table-description = Reveja a rodada, as regras, o lance atual, a vez e o veneno de cada jogador.
deadmansdice-review-bids = Rever lances
deadmansdice-review-bids-description = Reveja, em ordem, os lances desta rodada.
deadmansdice-review-last-reveal = Rever última revelação
deadmansdice-review-last-reveal-description = Reveja todos os dados revelados e o resultado do desafio anterior.

