game-name-deadmansdice = Xúc Xắc Tử Thần

deadmansdice-set-rules = Luật chơi: { $rules }
deadmansdice-select-rules = Chọn luật chơi
deadmansdice-option-changed-rules = Đã đổi luật chơi thành { $rules }.
deadmansdice-rules-traditional = Truyền thống
deadmansdice-rules-basic = Cơ bản
deadmansdice-rules-unsupported = Không được hỗ trợ
deadmansdice-rules-description = Luật Truyền thống coi mặt một là mặt hoang khi đếm mặt hai đến mặt sáu. Luật Cơ bản chỉ tính đúng từng mặt. Cả hai luật đều cho phép gọi Chính xác.

deadmansdice-call-liar = Vạch mặt
deadmansdice-call-liar-description = Thách thức lời cược hiện tại. Nếu cược quá cao, người ra cược phải uống độc; nếu không, bạn phải uống.
deadmansdice-call-liar-current = Vạch mặt — { $quantity } viên ra mặt { $face }
deadmansdice-call-liar-current-description = Thách thức lời cược { $quantity } viên ra mặt { $face }. Nếu cược quá cao, người ra cược phải uống độc; nếu không, bạn phải uống.
deadmansdice-call-spot-on = Gọi Chính xác
deadmansdice-call-spot-on-description = Khẳng định lời cược hiện tại đúng tuyệt đối. Nếu bạn đúng, mọi người còn sống khác phải uống độc; nếu sai, bạn phải uống.
deadmansdice-call-spot-on-current = Gọi Chính xác — đúng { $quantity } viên ra mặt { $face }
deadmansdice-call-spot-on-current-description = Khẳng định có đúng { $quantity } viên ra mặt { $face }. Nếu bạn đúng, mọi người còn sống khác phải uống độc; nếu sai, bạn phải uống.
deadmansdice-bid-face = Cược mặt { $face }
deadmansdice-bid-face-minimum = Cược mặt { $face } — từ { $minimum } trở lên
deadmansdice-bid-face-description = Chọn số lượng, rồi cược toàn bàn có từng ấy viên ra mặt { $face }.
deadmansdice-select-bid-quantity = Chọn số lượng cược
deadmansdice-select-bid-quantity-for-face = Đang cược mặt { $face }. Hãy chọn số lượng.
deadmansdice-bid-option = { $quantity } viên ra mặt { $face }
deadmansdice-read-dice = Đọc xúc xắc của bạn
deadmansdice-read-dice-description = Nghe lại năm viên xúc xắc bí mật của bạn.
deadmansdice-read-table = Đọc tình hình bàn
deadmansdice-read-table-description = Xem vòng đấu, luật chơi, lời cược hiện tại, lượt đi và số liều độc của từng người.
deadmansdice-review-bids = Xem lại các lời cược
deadmansdice-review-bids-description = Xem lại các lời cược của vòng này theo đúng thứ tự.
deadmansdice-review-last-reveal = Xem lại lần mở cốc gần nhất
deadmansdice-review-last-reveal-description = Xem lại toàn bộ xúc xắc đã mở và kết quả lần thách thức trước.

deadmansdice-face-1 = một
deadmansdice-face-2 = hai
deadmansdice-face-3 = ba
deadmansdice-face-4 = bốn
deadmansdice-face-5 = năm
deadmansdice-face-6 = sáu
deadmansdice-face-1-singular = một
deadmansdice-face-2-singular = hai
deadmansdice-face-3-singular = ba
deadmansdice-face-4-singular = bốn
deadmansdice-face-5-singular = năm
deadmansdice-face-6-singular = sáu

deadmansdice-intro = Quán rượu bỗng lặng như tờ. Những chiếc cốc úp xuống bàn. Chỉ một người còn đủ sức bước ra.
deadmansdice-match-setup-traditional = { $players } người. Luật đang dùng: { $rules }. Mặt một thay cho mặt hai đến mặt sáu; cược mặt một chỉ đếm đúng mặt một.
deadmansdice-match-setup-basic = { $players } người. Luật đang dùng: { $rules }. Mỗi mặt chỉ tính cho chính nó, kể cả mặt một.
deadmansdice-match-setup-unsupported = Bàn không thể bắt đầu vì luật chơi này không còn được hỗ trợ.
deadmansdice-round-start = Vòng { $round }. { $players } người còn sống lắc tổng cộng { $dice } viên xúc xắc dưới cốc.
deadmansdice-your-dice = Xúc xắc của bạn: { $dice }.
deadmansdice-you-bid = Bạn cược { $quantity } viên ra mặt { $face }.
deadmansdice-player-bids = { $player } cược { $quantity } viên ra mặt { $face }.
deadmansdice-you-call-liar = Bạn vạch mặt lời cược { $quantity } viên ra mặt { $face } của { $bidder }.
deadmansdice-player-calls-liar = { $player } vạch mặt lời cược { $quantity } viên ra mặt { $face } của { $bidder }.
deadmansdice-you-call-spot-on = Bạn gọi Chính xác với lời cược { $quantity } viên ra mặt { $face } của { $bidder }.
deadmansdice-player-calls-spot-on = { $player } gọi Chính xác với lời cược { $quantity } viên ra mặt { $face } của { $bidder }.
deadmansdice-your-cup-reveals = Bạn nhấc cốc: { $dice }.
deadmansdice-player-cup-reveals = { $player } nhấc cốc: { $dice }.
deadmansdice-reveal-total = Đếm được { $actual } viên. Lời cược là { $quantity } viên ra mặt { $face }.
deadmansdice-your-bid-too-high = Lời cược của bạn sụp đổ khi mở cốc. Bạn thua lần thách thức này.
deadmansdice-player-bid-too-high = Lời cược của { $player } sụp đổ khi mở cốc. { $player } thua lần thách thức này.
deadmansdice-you-challenged-truth = Lời cược đứng vững sau khi mở cốc. Bạn thua lần thách thức này.
deadmansdice-player-challenged-truth = Lời cược đứng vững sau khi mở cốc. { $player } thua lần thách thức này.
deadmansdice-your-spot-on-correct = Bạn gọi Chính xác không sai một viên. Tất cả những người khác phải uống.
deadmansdice-player-spot-on-correct = { $player } gọi đúng không sai một viên. Tất cả những người khác phải uống.
deadmansdice-your-spot-on-wrong = Bạn gọi Chính xác nhưng đã trượt. Chén độc thuộc về bạn.
deadmansdice-player-spot-on-wrong = { $player } gọi trượt và phải uống độc.
deadmansdice-you-drink-poison = Bạn uống cạn chén độc. Liều { $doses } trên { $maximum }.
deadmansdice-player-drinks-poison = { $player } uống cạn chén độc. Liều { $doses } trên { $maximum }.
deadmansdice-you-eliminated = Liều thứ hai đã hạ gục bạn. Bạn bị loại.
deadmansdice-player-eliminated = Liều thứ hai đã hạ gục { $player }. { $player } bị loại.
deadmansdice-you-win = Bạn là người sống sót cuối cùng. Bạn thắng Xúc Xắc Tử Thần.
deadmansdice-player-wins = { $player } là người sống sót cuối cùng và thắng Xúc Xắc Tử Thần.

deadmansdice-action-opening = Bàn chơi vẫn đang lắng xuống. Hãy chờ lượt gieo đầu tiên.
deadmansdice-action-opening-no-dice = Cốc của bạn vẫn trống. Lượt gieo mở màn chưa bắt đầu.
deadmansdice-action-opening-no-bids = Chưa ai gieo xúc xắc nên chưa có lời cược nào để xem lại.
deadmansdice-action-eliminated = Bạn đã bị loại khỏi trận này.
deadmansdice-action-no-bid = Chưa có lời cược nào nên không thể thách thức.
deadmansdice-action-face-unavailable = Không còn cách tăng cược hợp lệ nào cho mặt này.
deadmansdice-action-invalid-bid = Lời cược đó không còn hợp lệ; diễn biến trên bàn đã thay đổi.
deadmansdice-action-selection-open = Hãy hoàn tất hoặc hủy phần chọn lời cược đang mở trước.
deadmansdice-action-sequence-running = Lần thách thức vẫn chưa ngã ngũ. Hãy chờ kết quả cuối cùng.
deadmansdice-action-no-dice = Bạn không có lượt gieo đang hoạt động để nghe lại.
deadmansdice-action-no-last-reveal = Chưa có lần thách thức nào được mở cốc.

deadmansdice-table-opening-header = Xúc Xắc Tử Thần — bàn đang vào cuộc, luật { $rules }
deadmansdice-table-header = Xúc Xắc Tử Thần — vòng { $round }, luật { $rules }
deadmansdice-table-pool-opening = { $players } người đang chờ với { $dice } viên xúc xắc chưa gieo.
deadmansdice-table-pool =
    { $players ->
        [one] 1 người còn sống
       *[other] { $players } người còn sống
    }; có { $dice } viên xúc xắc trong cuộc.
deadmansdice-table-rule-traditional = Mặt một là mặt hoang khi cược mặt hai đến mặt sáu. Cược mặt một chỉ đếm đúng mặt một. Có thể gọi Chính xác.
deadmansdice-table-rule-basic = Mỗi mặt chỉ được tính đúng theo giá trị của nó, kể cả mặt một. Có thể gọi Chính xác.
deadmansdice-table-rule-unsupported = Luật đã chọn không được hỗ trợ; trận này không thể tiếp tục.
deadmansdice-table-current-bid-you = Lời cược hiện tại của bạn: { $quantity } viên ra mặt { $face }.
deadmansdice-table-current-bid = Lời cược hiện tại: { $quantity } viên ra mặt { $face }, do { $player } đưa ra.
deadmansdice-table-no-bid = Vòng này chưa có lời cược nào.
deadmansdice-table-turn-you = Đang là lượt của bạn.
deadmansdice-table-turn = Đang là lượt của { $player }.
deadmansdice-table-no-turn = Chưa có lượt nào bắt đầu.
deadmansdice-table-player-you = Bạn: liều độc { $doses } trên { $maximum }.
deadmansdice-table-player = { $player }: liều độc { $doses } trên { $maximum }.
deadmansdice-table-player-you-eliminated = Bạn: đã bị loại.
deadmansdice-table-player-eliminated = { $player }: đã bị loại.
deadmansdice-bids-header = Các lời cược ở vòng { $round }
deadmansdice-bids-none = Vòng này chưa có lời cược nào.
deadmansdice-bids-line-you = { $index }. Bạn: { $quantity } viên ra mặt { $face }.
deadmansdice-bids-line = { $index }. { $player }: { $quantity } viên ra mặt { $face }.
deadmansdice-last-reveal-header = Lần mở cốc gần nhất — vòng { $round }
deadmansdice-last-reveal-player-you = Bạn: { $dice }.
deadmansdice-last-reveal-player = { $player }: { $dice }.
deadmansdice-last-reveal-pending = Các cốc vẫn đang được nhấc lên lần lượt.
deadmansdice-last-reveal-result = Cược: { $quantity } viên ra mặt { $face }. Thực tế: { $actual }. { $result }
deadmansdice-last-result-liar-bidder-lost-you = Lời cược của bạn quá cao; bạn thua lần thách thức này.
deadmansdice-last-result-liar-challenger-lost-you = Lời cược đứng vững; bạn thua lần thách thức này.
deadmansdice-last-result-spot-correct-you = Bạn gọi Chính xác hoàn toàn đúng; tất cả những người khác đã uống độc.
deadmansdice-last-result-spot-wrong-you = Bạn gọi Chính xác nhưng đã trượt; bạn phải uống độc.
deadmansdice-last-result-liar-bidder-lost = Lời cược quá cao; { $player } thua lần thách thức này.
deadmansdice-last-result-liar-challenger-lost = Lời cược đứng vững; { $player } thua lần thách thức này.
deadmansdice-last-result-spot-correct = Lời gọi Chính xác hoàn toàn đúng; tất cả mọi người trừ { $player } đã uống độc.
deadmansdice-last-result-spot-wrong = Lời gọi Chính xác đã trượt; { $player } phải uống độc.
deadmansdice-last-result-unavailable = Không thể đọc lại kết quả của lần thách thức trước.

deadmansdice-results-header = Kết quả Xúc Xắc Tử Thần
deadmansdice-results-winner = Người sống sót cuối cùng: { $player }.
deadmansdice-results-line = { $player }: { $status }; { $bids } lời cược, { $challenges } lần vạch mặt, { $spots } lần gọi Chính xác, { $poison } liều độc.
deadmansdice-results-survived = sống sót
deadmansdice-results-eliminated = bị loại
deadmansdice-error-rules-invalid = Luật chơi đã chọn không được hỗ trợ.
